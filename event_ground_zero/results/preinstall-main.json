{
  "service": {
    "id": "ab28dca6-7bea-4956-bdb9-dbb7b4c74635",
    "name": "Btc-15min-bot"
  },
  "environment": {
    "id": "61775c5d-c583-4dfc-af41-f25578856fd9",
    "name": "production"
  },
  "config": {
    "source": {
      "repo": "yz272n2tpf-lab/Btc-15min-bot",
      "branch": "main",
      "checkSuites": false
    },
    "networking": {
      "serviceDomains": {
        "btc-15min-bot-production.up.railway.app": {
          "port": 8080
        }
      },
      "privateNetworkEndpoint": "btc-15min-bot"
    },
    "build": {
      "builder": "RAILPACK",
      "buildEnvironment": "V3"
    },
    "deploy": {
      "startCommand": "/bin/sh -c 'sleep 3; echo \"BTC15 VOLUME INVENTORY BEGIN\" >&2; du -ah /data 2>/dev/null | sort -hr | head -40 >&2; echo \"BTC15 VOLUME INVENTORY END\" >&2; sleep 1; python btc15_preserve_evidence_v1.py --root /data --label pre-two-clock-pr37-20260925 && exec python -u btc15_information_install_v1.py'",
      "healthcheckPath": "/health",
      "healthcheckTimeout": 120,
      "useLegacyStacker": false,
      "ipv6EgressEnabled": false,
      "runtime": "V2",
      "multiRegionConfig": {
        "iad": {
          "numReplicas": 1
        }
      }
    },
    "volumeMounts": {
      "6ced6b1a-3755-4518-a240-c895e936d443": {
        "mountPath": "/data"
      }
    }
  },
  "variableNames": [
    "BTC15_BRTI_GATEWAY_URL",
    "BTC15_BRTI_SHARED_URL",
    "BTC15_BRTI_TRANSPORT",
    "BTC15_CAPTURE_ACTIVATION",
    "BTC15_DASH_V13_Z1",
    "BTC15_DASH_V13_Z2",
    "BTC15_DASH_V13_Z3",
    "BTC15_DASH_V13_Z4",
    "BTC15_DASH_V13_Z5",
    "BTC15_ENABLE_INFORMATION_EXPORT",
    "BTC15_INLINE_SCALP_V1",
    "BTC15_KALSHI_QUOTE_PROVENANCE_CANARY",
    "BTC15_USE_SHARED_BRTI",
    "BTC15_VOLUME_DIAG",
    "KALSHI_KEY_ID",
    "KALSHI_PRIVATE_KEY_B64",
    "PORT",
    "PYTHONUNBUFFERED"
  ],
  "staged": null
}
