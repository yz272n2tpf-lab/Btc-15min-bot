+def _bounded_startup_failure_status(last):
+ """Best-effort local mTLS /state after failed startup, never upstream.
+
+ A bounded loopback GET cannot initiate a BRTI upstream poll (per feed handler).
+ No prices, timestamps, credentials, endpoints, messages or raw JSON are logged.
+ The existing 10-second qualification gate is not relaxed.
+ """
+ status={'last_check_class':type(last).__name__ if last else 'UNKNOWN',
+         'probe':'NOT_ATTEMPTED'}
+ try:
+  if os.geteuid()!=0 or os.environ.get('CREDENTIALS_DIRECTORY')!='/etc/btc15-pilot/health':
+   status['probe']='MISSING_ROOT_HEALTH_CONTEXT'
+   return status
+  from btc15_v2_product.brti_profile import current
+  from btc15_v2_product.local_tls import request_options
+  import requests
+  b=current()
+  if b.get('endpoint')!='https://127.0.0.1:8443':
+   status['probe']='ENDPOINT_NOT_FIXED_LOOPBACK'
+   return status
+  with requests.Session() as session:
+   session.trust_env=False
+   response=session.get('https://127.0.0.1:8443/state',
+                        timeout=0.65,allow_redirects=False,**request_options(b))
+  if response.status_code!=200:
+   status['probe']='LOCAL_HTTP_NON_200'
+   status['local_http_status']=int(response.status_code)
+   return status
+  # Reject oversized /state payloads. Never log the original response.
+  if len(response.content)>16384:
+   status['probe']='LOCAL_STATE_OVERSIZE'
+   return status
+  snap=response.json()
+  if not isinstance(snap,dict):
+   status['probe']='LOCAL_STATE_MALFORMED'
+   return status
+  status['probe']='LOCAL_STATE_RECEIVED'
+  if snap.get('status') in ('PRIMARY_OK','PRIMARY_ERROR','BOOTING'):
+   status['feed_status']=snap['status']
+  if type(snap.get('clean_for_qualification')) is bool:
+   status['qualified']=snap['clean_for_qualification']
+  if snap.get('last_error_type') in ('http','http_429','timeout','connection','other'):
+   status['last_error_type']=snap['last_error_type']
+  for key in ('upstream_attempts','upstream_ok','upstream_errors',
+              'http_429','timeout_errors','http_errors','connection_errors',
+              'other_errors','sequence'):
+   value=snap.get(key)
+   if type(value) is int and 0<=value<=100000000:
+    status[key]=value
+  for key in ('age_ms','max_qualification_age_ms'):
+   value=snap.get(key)
+   if type(value) in (float,int) and 0<=value<=10000000:
+    status[key]=round(value,1)
+ except Exception as exc:
+  # Only the Python exception class is emitted, no message (may contain URLs).
+  status['probe']='LOCAL_PROBE_'+type(exc).__name__
+ return status
+
